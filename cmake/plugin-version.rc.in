#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PLUGIN_VERSION_COMMAS@,0
PRODUCTVERSION @PLUGIN_VERSION_COMMAS@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Sarxina"
            VALUE "FileDescription", "@PLUGIN_DESCRIPTION@"
            VALUE "FileVersion", "@PLUGIN_VERSION@"
            VALUE "InternalName", "@PLUGIN_NAME@"
            VALUE "OriginalFilename", "@PLUGIN_NAME@.dll"
            VALUE "ProductName", "Sarxina OBS Plugins"
            VALUE "ProductVersion", "@PLUGIN_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
